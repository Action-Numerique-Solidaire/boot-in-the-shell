[Unit]
Description=BITS : publication des médias PXE au démarrage
Wants=network-online.target
After=network-online.target nginx.service nfs-server.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/bitsctl apply
# Un téléchargement d'image peut durer longtemps ; rien n'attend ce service.
TimeoutStartSec=0
# 3 : publié, mais un média au moins a été écarté (téléchargement ou empreinte
# en échec). Le serveur sert les autres : ce n'est pas une panne.
SuccessExitStatus=3

[Install]
WantedBy=multi-user.target
