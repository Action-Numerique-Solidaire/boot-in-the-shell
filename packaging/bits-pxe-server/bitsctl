#!/usr/bin/env bash
# bitsctl — pilotage du serveur PXE Boot in the Shell.
#
#   bitsctl status                 état du serveur, du réseau et des médias
#   bitsctl apply                  publier maintenant (téléchargement, menu,
#                                  services), puis à chaque démarrage
#   bitsctl enable                 publier à chaque démarrage, sans publier
#                                  maintenant (installation dans un chroot)
#   bitsctl disable                arrêter de répondre aux démarrages PXE
#   bitsctl media list             catalogue et état de chaque média
#   bitsctl media enable <id>      activer un média (pris en compte à apply)
#   bitsctl media disable <id>     désactiver un média (idem)
#   bitsctl media download <id>    télécharger et vérifier un média, activé ou
#                                  non, SANS le publier ; --arriere-plan le
#                                  lance dans bits-telechargement@<id>.service
#   bitsctl log [-f]               journal de la dernière opération
#
# Les journaux sont gardés dans /var/log/bits/ ; derniere.log désigne celui de
# la dernière opération (publication ou téléchargement).
set -Eeuo pipefail

SCRIPTS="${BITS_SCRIPTS:-/usr/share/bits-pxe-server/scripts}"
export PXE_CONFIG_FILE="${PXE_CONFIG_FILE:-/etc/bits-pxe-server/pxe.env}"
export PXE_MEDIA_FILE="${PXE_MEDIA_FILE:-/etc/bits-pxe-server/media.conf}"
# Catalogue de référence livré avec le paquet. media.conf, lui, est un
# conffile : une image ajoutée dans une version ultérieure n'y apparaît pas
# lors d'une mise à jour. « media enable » la reprend alors d'ici.
CATALOGUE="${BITS_CATALOGUE:-/usr/share/bits-pxe-server/catalogue.conf}"
LOG_DIR="${BITS_LOG_DIR:-/var/log/bits}"
STATE_DIR="${PXE_STATE_DIR:-/var/lib/bits}"
LOCK=/run/bits-apply.lock

# shellcheck source=/dev/null
source "$SCRIPTS/lib/common.sh"

usage() { sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

etat_service() {
  local s="$1" a e
  a="$(systemctl is-active "$s" 2>/dev/null || true)"
  e="$(systemctl is-enabled "$s" 2>/dev/null || true)"
  printf '  %-22s %-10s %s\n' "$s" "${a:-inconnu}" "${e:-inconnu}"
}

cmd_status() {
  load_config
  echo "Serveur PXE : $PXE_IP sur $PXE_INTERFACE ($PXE_SUBNET_CIDR)"
  echo "Interface web : http://$PXE_IP/"
  echo "Données : $PXE_DATA_MOUNT ($(df -h --output=avail "$PXE_DATA_MOUNT" 2>/dev/null | tail -1 | tr -d ' ') libres)"
  echo
  echo "Services :"
  for s in bits-dnsmasq nginx nfs-server bits-sync; do etat_service "$s.service"; done
  echo
  cmd_media_list
  echo
  if [[ -e "$LOG_DIR/apply-latest.log" ]]; then
    echo "Dernière publication : $(readlink -f "$LOG_DIR/apply-latest.log")"
    tail -n 1 "$LOG_DIR/apply-latest.log"
  else
    echo "Aucune publication encore : lancer « sudo bitsctl apply »."
  fi
}

cmd_media_list() {
  local prets=" " ecartes=" "
  [[ -f "$STATE_DIR/media-publies" ]] && prets=" $(tr '\n' ' ' < "$STATE_DIR/media-publies")"
  [[ -f "$STATE_DIR/media-ecartes" ]] && ecartes=" $(tr '\n' ' ' < "$STATE_DIR/media-ecartes")"
  printf '  %-8s %-16s %-16s %s\n' ACTIVÉ ID TYPE LIBELLÉ
  while IFS='|' read -r enabled id type _ _ _ label; do
    [[ "$enabled" =~ ^[[:space:]]*# || -z "$id" ]] && continue
    etat="$enabled"
    if [[ "$enabled" == yes ]]; then
      if [[ "$prets" == *" $id "* ]]; then etat="publié"
      elif [[ "$ecartes" == *" $id "* ]]; then etat="ÉCARTÉ"
      else etat="à publier"; fi
    else
      etat="non"
    fi
    printf '  %-8s %-16s %-16s %s\n' "$etat" "$id" "$type" "$label"
  done < <(liste_catalogue)
}

# Lignes du catalogue local, puis celles du catalogue de référence dont
# l'identifiant n'y figure pas (montrées désactivées).
liste_catalogue() {
  awk -F '|' -v OFS='|' '
    $0 ~ /^[[:space:]]*#/ || NF < 7 { next }
    FILENAME == ARGV[1] { vu[$2] = 1; print; next }
    !($2 in vu) { $1 = "no"; print }' "$PXE_MEDIA_FILE" "$([[ -f "$CATALOGUE" ]] && echo "$CATALOGUE" || echo /dev/null)"
}

# Absent du catalogue local mais connu du catalogue de référence : on ajoute
# sa ligne, désactivée.
assurer_ligne() {
  local id="$1" ligne
  if ! awk -F '|' -v id="$id" '$0 !~ /^[[:space:]]*#/ && NF >= 7 && $2 == id { f = 1 } END { exit !f }' "$PXE_MEDIA_FILE"; then
    ligne="$(awk -F '|' -v OFS='|' -v id="$id" '$0 !~ /^[[:space:]]*#/ && NF >= 7 && $2 == id { $1 = "no"; print; exit }' "$CATALOGUE" 2>/dev/null || true)"
    [[ -n "$ligne" ]] || die "Média inconnu : $id (ni dans $PXE_MEDIA_FILE ni dans $CATALOGUE)"
    printf '%s\n' "$ligne" >> "$PXE_MEDIA_FILE"
  fi
}

cmd_media_set() {
  local id="$1" val="$2" tmp
  require_root
  safe_id "$id"
  assurer_ligne "$id"
  tmp="$(mktemp "$PXE_MEDIA_FILE.XXXXXX")"
  if ! awk -F '|' -v OFS='|' -v id="$id" -v val="$val" '
      $0 !~ /^[[:space:]]*#/ && NF >= 7 && $2 == id { $1 = val; found = 1 }
      { print }
      END { exit !found }' "$PXE_MEDIA_FILE" > "$tmp"; then
    rm -f "$tmp"
    die "Média inconnu dans $PXE_MEDIA_FILE : $id"
  fi
  chmod --reference="$PXE_MEDIA_FILE" "$tmp"
  mv -f "$tmp" "$PXE_MEDIA_FILE"
  echo "$id : $([[ $val == yes ]] && echo activé || echo désactivé). Prise en compte : sudo bitsctl apply"
}

# Une seule opération à la fois, publication ou téléchargement : elles écrivent
# dans les mêmes fichiers. Le verrou est aussi ce que lit l'interface web pour
# savoir qu'une opération est en cours.
prendre_verrou() {
  exec 9>"$LOCK"
  flock -n 9 || die "Une opération (publication ou téléchargement) est déjà en cours."
}

nouveau_journal() {
  local logf
  install -d -m 0755 "$LOG_DIR"
  logf="$LOG_DIR/$1-$(date '+%Y%m%d-%H%M%S').log"
  : > "$logf"
  ln -sfn "$(basename "$logf")" "$LOG_DIR/derniere.log"
  printf '%s' "$logf"
}

cmd_download() {
  local id="$1" logf rc
  require_root
  safe_id "$id"
  assurer_ligne "$id"
  prendre_verrou
  logf="$(nouveau_journal "telechargement-$id")"
  set +e
  "$SCRIPTS/40-download-media.sh" --seulement "$id" 2>&1 | tee -a "$logf"
  rc=${PIPESTATUS[0]}
  set -e
  find "$LOG_DIR" -maxdepth 1 -name 'telechargement-*.log' | sort | head -n -30 | xargs -r rm -f
  if [[ $rc -ne 0 ]]; then
    echo "ÉCHEC du téléchargement de $id (code $rc). Journal : $logf" | tee -a "$logf"
    return "$rc"
  fi
  echo "Téléchargement réussi : $id (non publié). Journal : $logf" | tee -a "$logf"
}

cmd_download_arriere_plan() {
  local id="$1"
  require_root
  safe_id "$id"
  assurer_ligne "$id"
  # Dans sa propre unité : le téléchargement va au bout même si l'appelant
  # (l'interface web) redémarre entre-temps.
  systemctl start --no-block "bits-telechargement@$id.service"
  echo "Téléchargement de $id lancé : bitsctl log -f"
}

cmd_apply() {
  require_root
  prendre_verrou

  local logf rc ecartes=0
  logf="$(nouveau_journal apply)"
  ln -sfn "$(basename "$logf")" "$LOG_DIR/apply-latest.log"

  set +e
  (
    set -Eeuo pipefail
    for step in 00-validate-config 10-install-prerequisites 30-configure-network \
                40-download-media 50-build-ipxe 60-publish-media 70-enable-and-validate; do
      echo
      echo "=== $step ==="
      "$SCRIPTS/$step.sh"
    done
  ) 2>&1 | tee "$logf"
  rc=${PIPESTATUS[0]}
  set -e

  [[ -s "$STATE_DIR/media-ecartes" ]] && ecartes="$(wc -l < "$STATE_DIR/media-ecartes")"
  # On garde les 30 derniers journaux.
  find "$LOG_DIR" -maxdepth 1 -name 'apply-2*.log' | sort | head -n -30 | xargs -r rm -f

  if [[ $rc -ne 0 ]]; then
    echo "ÉCHEC de la publication (code $rc). Journal : $logf" | tee -a "$logf"
    return "$rc"
  fi
  # « Publié » ne vaut qu'après une publication réussie : la liste des
  # médias prêts (étape 40) ne dit pas que la suite a abouti.
  cp -f "$STATE_DIR/media-prets" "$STATE_DIR/media-publies"
  noter_versions_publiees
  systemctl enable --quiet bits-sync.service
  if [[ $ecartes -gt 0 ]]; then
    echo "Publié, mais $ecartes média(s) écarté(s) : voir « bitsctl media list ». Journal : $logf" | tee -a "$logf"
    return 3
  fi
  echo "Publication réussie. Journal : $logf" | tee -a "$logf"
}

# « id empreinte » de chaque média publié : l'interface web compare avec la
# copie téléchargée pour signaler une nouvelle version pas encore servie.
noter_versions_publiees() {
  local id fichier
  load_config
  while IFS='|' read -r _ id _ fichier _ _ _; do
    grep -qxF "$id" "$STATE_DIR/media-publies" || continue
    printf '%s %s\n' "$id" "$(cat "$PXE_DATA_MOUNT/downloads/$fichier.sha256" 2>/dev/null || echo inconnue)"
  done < <(liste_catalogue) > "$STATE_DIR/versions-publiees.tmp"
  mv -f "$STATE_DIR/versions-publiees.tmp" "$STATE_DIR/versions-publiees"
}

cmd_enable() {
  require_root
  systemctl enable bits-sync.service
  echo "La publication aura lieu à chaque démarrage."
}

cmd_disable() {
  require_root
  systemctl disable --now bits-sync.service bits-dnsmasq.service
  echo "Le serveur ne répond plus aux démarrages PXE. Réactiver : sudo bitsctl apply"
}

cmd_log() {
  local j="$LOG_DIR/derniere.log"
  [[ -e "$j" ]] || j="$LOG_DIR/apply-latest.log"
  [[ -e "$j" ]] || die "Aucun journal dans $LOG_DIR."
  if [[ "${1:-}" == -f ]]; then
    exec tail -n +1 -F "$j"
  fi
  cat "$j"
}

case "${1:-}" in
  status)  cmd_status ;;
  apply)   cmd_apply ;;
  enable)  cmd_enable ;;
  disable) cmd_disable ;;
  log)     shift; cmd_log "$@" ;;
  media)
    # Nombre d'arguments exact : sudo accorde « bitsctl media … * » à
    # l'interface web, un argument en trop doit être refusé, pas ignoré.
    case "${2:-}:$#" in
      list:2|:1)                 cmd_media_list ;;
      enable:3)                  cmd_media_set "$3" yes ;;
      disable:3)                 cmd_media_set "$3" no ;;
      download:3)                cmd_download "$3" ;;
      download:4)
        [[ "$3" == --arriere-plan ]] || usage
        cmd_download_arriere_plan "$4" ;;
      *)                         usage ;;
    esac
    ;;
  -h|--help|help) usage ;;
  *) usage ;;
esac
