# Configuration de bits-pxe-server (copier vers config/pxe.env pour un lancement depuis le dépôt).
#
# Rien n'est obligatoire : sans valeur, le réseau est lu sur l'interface
# active (celle de la route par défaut) et les données vont dans
# PXE_DATA_MOUNT, sur le système de fichiers racine.
# Prise en compte : sudo bitsctl apply

# --- Réseau (déduit si vide) ---------------------------------------------------
#PXE_INTERFACE=enp1s0
#PXE_ADDRESS_CIDR=192.168.1.15/24
#PXE_SUBNET_CIDR=192.168.1.0/24

# yes : BITS écrit une configuration Netplan statique (Ubuntu seulement), avec
# PXE_ADDRESS_CIDR, PXE_GATEWAY et PXE_DNS. Par défaut le réseau appartient au
# système.
PXE_MANAGE_NETWORK=no
#PXE_GATEWAY=192.168.1.1
#PXE_DNS=192.168.1.1

# --- Données ---------------------------------------------------------------------
# Images téléchargées, extraites et images Clonezilla.
PXE_DATA_MOUNT=/srv/bits-data
# Disque dédié, facultatif. Renseigné, PXE_DATA_MOUNT doit être monté, et
# « bits-pxe-install --prepare-data-disk » efface ENTIÈREMENT ce disque.
# Utiliser exclusivement un chemin stable /dev/disk/by-id/.
#PXE_DATA_DISK=/dev/disk/by-id/...
#PXE_DATA_PARTITION=/dev/disk/by-id/...-part1

# --- Arborescences servies ---------------------------------------------------------
PXE_HTTP_ROOT=/var/www/html/pxe
PXE_TFTP_ROOT=/srv/tftp
PXE_NFS_MOUNT_ROOT=/mnt/pxe-media

# --- iPXE --------------------------------------------------------------------------
# Par défaut, les chargeurs du paquet ipxe. Pour les compiler (git, gcc,
# liblzma-dev requis) avec le script embarqué de BITS :
#PXE_IPXE_COMPILE=yes
IPXE_GIT_URL=https://github.com/ipxe/ipxe.git
IPXE_GIT_COMMIT=45af75d2af3b85af51bc0d16af5df30abff1935b
# Ou des chargeurs déjà compilés (tools/construire-ipxe.sh) :
#PXE_IPXE_PREBUILT=/chemin/vers/ipxe

# --- Windows -----------------------------------------------------------------------
# Seulement si un média windows-iso est activé.
WIMBOOT_URL=https://github.com/ipxe/wimboot/releases/download/v2.9.0/wimboot
WIMBOOT_SHA256=5f067ccdc4d084d5bf77b6c853bd0f8402dfc2b4cd1b103d358993ae97fae8e3
