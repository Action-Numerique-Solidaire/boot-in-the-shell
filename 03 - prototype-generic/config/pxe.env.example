# Copier ce fichier vers config/pxe.env puis adapter toutes les valeurs.

PXE_HOSTNAME=pxe-server
PXE_INTERFACE=enp1s0
PXE_ADDRESS_CIDR=192.168.1.15/24
PXE_GATEWAY=192.168.1.1
PXE_DNS=192.168.1.1
PXE_SUBNET_CIDR=192.168.1.0/24

# Utiliser exclusivement un chemin stable /dev/disk/by-id/.
PXE_DATA_DISK=/dev/disk/by-id/REPLACE_ME
PXE_DATA_PARTITION=/dev/disk/by-id/REPLACE_ME-part1
PXE_DATA_MOUNT=/srv/pxe-data

PXE_HTTP_ROOT=/var/www/html/pxe
PXE_TFTP_ROOT=/srv/tftp
PXE_NFS_MOUNT_ROOT=/mnt/pxe-media
PXE_BUILD_ROOT=/opt/generic-pxe

# yes : le playbook écrit une configuration Netplan statique.
# no  : l'adresse doit déjà être configurée avant l'installation des services.
PXE_MANAGE_NETWORK=no

# URL du binaire wimboot. Obligatoire seulement si un média windows-iso est activé.
WIMBOOT_URL=https://github.com/ipxe/wimboot/releases/download/v2.9.0/wimboot
WIMBOOT_SHA256=5f067ccdc4d084d5bf77b6c853bd0f8402dfc2b4cd1b103d358993ae97fae8e3

IPXE_GIT_URL=https://github.com/ipxe/ipxe.git
IPXE_GIT_COMMIT=45af75d2af3b85af51bc0d16af5df30abff1935b
